# Banco de dados (PostgreSQL)
# DATABASE_URL: connection string "pooled" (com "-pooler" no host) — usada
# pelo app em runtime (app/_lib/prisma.ts via @prisma/adapter-pg).
DATABASE_URL=

# DIRECT_URL: connection string direta (sem "-pooler" no host) — usada só
# pela CLI do Prisma (migrate, generate) via prisma.config.ts. O pooler do
# Neon (PgBouncer) não sustenta o advisory lock que as migrations usam,
# por isso precisa de uma conexão direta separada. No console do Neon:
# Connect > desmarque "Pooled connection" para ver essa URL.
DIRECT_URL=

# Clerk (autenticação)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# CRON_SECRET: usado por app/api/cron/generate-recurring para validar que a
# requisição veio mesmo do cron da Vercel (ela injeta automaticamente o
# header "Authorization: Bearer $CRON_SECRET" ao disparar o job — basta
# gerar um valor aleatório e cadastrar aqui/nas env vars do projeto).
CRON_SECRET=
