generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  PAID
  OVERDUE
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
  BANK_TRANSFER
  CASH
  INSTALLMENT
  OTHER
}

enum Role {
  ADMIN
  USER
}

// ==========================================
// MODELS
// ==========================================

model Organization {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  users            User[]
  clients          Client[]
  categories       Category[]
  transactions     Transaction[]
  installmentPlans InstallmentPlan[]

  @@index([deletedAt])
}

model User {
  id             String    @id @default(cuid())
  organizationId String
  clerkId        String?   @unique
  name           String
  email          String    @unique
  role           Role      @default(USER)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([organizationId])
  @@index([deletedAt])
}

model Client {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  email          String?
  document       String? // CPF or CNPJ
  phone          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([organizationId])
  @@index([deletedAt])
}

model Category {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  color          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([deletedAt])
}

model InstallmentPlan {
  id             String    @id @default(cuid())
  organizationId String
  name           String // e.g. "Divórcio João - Honorários"
  totalAmount    Int // Total amount in cents
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([organizationId])
  @@index([deletedAt])
}

model Transaction {
  id                String  @id @default(cuid())
  organizationId    String
  installmentPlanId String?
  clientId          String?
  categoryId        String?
  userId            String // Audit: User who created the transaction

  name          String // Client name or expense description
  description   String?           @db.Text
  amountInCents Int // Stored in cents
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  paymentMethod PaymentMethod

  // Installment specific (optional, used if paymentMethod is PARCELADO or belongs to a plan)
  installmentNumber Int?
  totalInstallments Int?

  dueDate DateTime
  paidAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installmentPlan InstallmentPlan? @relation(fields: [installmentPlanId], references: [id], onDelete: SetNull)
  client          Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  user            User             @relation(fields: [userId], references: [id])

  // Indexes for Dashboard and Reports filtering
  @@index([organizationId])
  @@index([organizationId, dueDate])
  @@index([organizationId, type, status])
  @@index([installmentPlanId])
  @@index([deletedAt])
}
