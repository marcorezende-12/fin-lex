generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================
enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  PAID
  OVERDUE
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
  BANK_TRANSFER
  CASH
  INSTALLMENT
  OTHER
}

enum Role {
  ADMIN
  USER
}

// ==========================================
// MODELS
// ==========================================
model User {
  id                    String   @id @default(cuid())
  clerkId               String?  @unique
  name                  String
  email                 String   @unique
  role                  Role     @default(USER)
  avatarUrl             String?
  
  // Novo campo adicionado
  onboardingCompleted   Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  // Relations
  clients               Client[]
  categories            Category[]
  transactions          Transaction[]
  installmentPlans      InstallmentPlan[]

  @@index([clerkId])
  @@index([deletedAt])
}

model Client {
  id          String   @id @default(cuid())
  userId      String
  name        String
  email       String?
  document    String?
  phone       String?
  birthDate   DateTime?
  nickName    String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  country     String?
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([deletedAt])
}

model Category {
  id          String   @id @default(cuid())
  userId      String
  name        String
  color       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
  @@index([deletedAt])
}

model InstallmentPlan {
  id                String   @id @default(cuid())
  userId            String
  name              String
  totalAmount       Int

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]

  @@index([userId])
  @@index([deletedAt])
}

model Transaction {
  id                   String            @id @default(cuid())
  
  userId               String
  clientId             String?
  categoryId           String?
  installmentPlanId    String?

  name                 String
  description          String?           @db.Text
  amountInCents        Int
  type                 TransactionType
  status               TransactionStatus @default(PENDING)
  paymentMethod        PaymentMethod

  installmentNumber    Int?
  totalInstallments    Int?

  dueDate              DateTime
  paidAt               DateTime?

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?

  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  client               Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  category             Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  installmentPlan      InstallmentPlan?  @relation(fields: [installmentPlanId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, dueDate])
  @@index([userId, type, status])
  @@index([installmentPlanId])
  @@index([deletedAt])
}